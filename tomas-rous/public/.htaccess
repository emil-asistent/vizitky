# tomasrous.cz – přesměrování na https a adresu bez www, chybová stránka, zákaz interních souborů, cache, komprese, bezpečnostní hlavičky
RewriteEngine On
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://tomasrous.cz%{REQUEST_URI} [R=301,L]
ErrorDocument 404 /404.html
<FilesMatch "^(\.ht.*|README.*|config\.example\.php|config\.php)$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
  Header always unset X-Powered-By
  Header unset X-Powered-By
  <FilesMatch "\.(woff2|jpg|webp|png|svg|css|js)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript image/svg+xml application/json text/plain application/xml
</IfModule>
AddType font/woff2 .woff2
AddType image/webp .webp
